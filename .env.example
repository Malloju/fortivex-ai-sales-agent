# ============================================================
# FortivexAI Sales Agent - Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Gemini AI Configuration ---
# Get a free API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Current supported models: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash, gemini-2.5-flash-lite
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# --- Application Mode ---
# Set to 'demo' to use deterministic responses without an API key.
# Set to 'production' to use real Gemini AI (requires GEMINI_API_KEY).
APP_MODE=demo

# --- Database Configuration ---
DATABASE_PATH=data/dreamhome.db

# --- ChromaDB Configuration ---
CHROMA_PATH=chroma_db

# --- Speech Recognition (Faster-Whisper) ---
# Options: tiny, base, small, medium (use base for local laptops)
WHISPER_MODEL=base

# --- Language Configuration ---
# Options: en (English), hi (Hindi), auto (auto-detect)
DEFAULT_LANGUAGE=en

# --- Conversation Context ---
CONVERSATION_HISTORY_LIMIT=20

# --- Timezone ---
TIMEZONE=Asia/Kolkata

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# --- Appointment Settings ---
# Business hours in 24h format
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=18
APPOINTMENT_DURATION_MINUTES=60

# --- TTS Voice Settings ---
# Edge TTS voices: en-IN-NeerjaNeural (English-India), hi-IN-SwaraNeural (Hindi)
TTS_VOICE_EN=en-IN-NeerjaNeural
TTS_VOICE_HI=hi-IN-SwaraNeural

# --- RAG Settings ---
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5

# --- Lead Scoring ---
SCORE_BUDGET=20
SCORE_LOCATION=20
SCORE_PROPERTY_TYPE=15
SCORE_TIMELINE=20
SCORE_CONTACT=15
SCORE_INTEREST=10
